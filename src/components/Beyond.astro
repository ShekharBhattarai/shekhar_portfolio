---
import { presentations, awards, additionalCourses, leadership, languages } from '../data/portfolio';
import SectionHeading from './SectionHeading.astro';
---

<section id="beyond">
  <SectionHeading title="Beyond the lab" />
  <div class="grid">
    <div class="card-accent accent-pink wide stack">
      <span class="eyebrow">Presentations</span>
      {
        presentations.map((p) => (
          <div class="item">
            <h3 class="display big">{p.title}</h3>
            <span class="where-strong">{p.where}</span>
          </div>
        ))
      }
    </div>

    <div class="card wide stack">
      <span class="eyebrow dim">Honors &amp; awards</span>
      {
        awards.map((a) => (
          <div class:list={['award', `accent-${a.accent}`]}>
            <span class="icon display">{a.icon}</span>
            <div class="item">
              <h3 class="display medium">{a.title}</h3>
              <span class="where">{a.where}</span>
            </div>
          </div>
        ))
      }
    </div>

    <div class="card">
      <span class="eyebrow dim">Additional courses</span>
      {
        additionalCourses.map((c) => (
          <div class="course">
            <span class="course-title">{c.title}</span>
            <span class="course-where">{c.where}</span>
          </div>
        ))
      }
    </div>

    <div class="card wide">
      <span class="eyebrow dim">Leadership &amp; volunteering</span>
      <div class="tiles">{leadership.map((l) => <span>{l}</span>)}</div>
    </div>

    <div class="card">
      <span class="eyebrow dim">Languages · signal strength</span>
      {
        languages.map((l) => (
          <div class="lang">
            <div class="lang-name">
              <span class="name">{l.name}</span>
              <span class="level">{l.level}</span>
            </div>
            <div class="bars" role="img" aria-label={`${l.bars} of 4`}>
              {[6, 11, 16, 22].map((h, i) => (
                <span class:list={{ on: i < l.bars }} style={`height:${h}px`} />
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }
  .wide { grid-column: span 2; }
  .stack { padding: 30px; display: flex; flex-direction: column; gap: 18px; }

  .item { display: flex; flex-direction: column; gap: 4px; }
  .big { font-weight: 700; font-size: 22px; line-height: 1.2; }
  .medium { font-weight: 700; font-size: 19px; line-height: 1.25; }
  .where-strong { font-size: 14px; font-weight: 600; }
  .where { font-size: 14px; color: var(--muted); }

  .award { display: flex; gap: 14px; }
  .icon { font-weight: 800; font-size: 22px; color: var(--at); }

  .course { display: flex; flex-direction: column; gap: 6px; }
  .course-title { font-size: 15px; font-weight: 700; line-height: 1.4; }
  .course-where { font-size: 13px; color: var(--muted); }

  .tiles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.45;
  }
  .tiles span {
    padding: 14px;
    border-radius: 18px;
    background: var(--card2);
  }

  .lang { display: flex; justify-content: space-between; align-items: center; }
  .lang-name { display: flex; flex-direction: column; }
  .name { font-weight: 800; font-size: 15px; }
  .level { font-size: 12px; color: var(--muted); }
  .bars { display: flex; align-items: flex-end; gap: 3px; height: 22px; }
  .bars span {
    width: 6px;
    border-radius: 2px;
    background: color-mix(in srgb, var(--ink) 15%, transparent);
  }
  .bars span.on { background: var(--ink); }

  @media (max-width: 1000px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 600px) {
    .grid > * { grid-column: span 2; }
    .tiles { grid-template-columns: 1fr; }
  }
</style>
